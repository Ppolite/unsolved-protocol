{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unsolved-protocol:schema:resolution-event:v0.1",
  "title": "UNSOLVED Resolution Event",
  "type": "object",
  "required": [
    "event_id",
    "challenge_id",
    "occurred_at",
    "from_state",
    "to_state",
    "protocol_version",
    "evidence_refs"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "challenge_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "from_state": {
      "type": ["string", "null"],
      "enum": [null, "REPORTED", "OPEN", "CLAIMED_RESOLVED", "VERIFIED_RESOLVED", "DISPUTED", "UNVERIFIABLE"]
    },
    "to_state": {
      "type": "string",
      "enum": ["REPORTED", "OPEN", "CLAIMED_RESOLVED", "VERIFIED_RESOLVED", "DISPUTED", "UNVERIFIABLE"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "decision_type": {
      "type": "string",
      "enum": ["administrative_update", "physical_verification", "manual_review", "correction", "appeal"]
    },
    "reviewer_count": {"type": "integer", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
